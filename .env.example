# Kopieren nach .env und anpassen. .env ist in .gitignore.

# Host-Ordner, der read-only nach /data gemountet wird (Basis des Ordner-Browsers).
HOST_DATA_DIR=./testdata
# Port der Oberfläche auf localhost.
PORT=8090

# Optionale Vorbelegung der Oberfläche (Service Key der Process Integration Runtime).
# Leer lassen, wenn die Werte lieber per "Service Key einfügen" gesetzt werden.
# Werte in EINFACHE Anführungszeichen setzen: XSUAA-Secrets enthalten oft ein "$",
# das Docker Compose in doppelten Anführungszeichen (oder ohne) als Variable auflöst.
CPI_ENDPOINT_URL=''
CPI_TOKEN_URL=''
CPI_CLIENT_ID=''
CPI_CLIENT_SECRET=''
